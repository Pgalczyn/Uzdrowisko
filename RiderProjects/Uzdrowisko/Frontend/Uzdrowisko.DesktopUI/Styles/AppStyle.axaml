<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <SolidColorBrush x:Key="SpaGlassBg">#8014231A</SolidColorBrush>
        <SolidColorBrush x:Key="SpaGlassBorder">#33FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SpaItemBg">#28FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SpaItemHover">#40FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SpaItemBorder">#22FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SpaAccent">#3E6B4E</SolidColorBrush>
        <SolidColorBrush x:Key="SpaTextPrimary">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SpaTextMuted">#A3C6B1</SolidColorBrush>
        <CornerRadius x:Key="SpaCardRadius">20</CornerRadius>
        <CornerRadius x:Key="SpaItemRadius">14</CornerRadius>
    </Styles.Resources>

    <Style Selector="Border.glassCard">
        <Setter Property="Background" Value="{StaticResource SpaGlassBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SpaGlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource SpaCardRadius}"/>
        <Setter Property="BoxShadow" Value="0 16 32 0 #45000000"/>
    </Style>
    <Style Selector="Border.treatmentCard">
        <Setter Property="Background" Value="{StaticResource SpaItemBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SpaItemBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource SpaItemRadius}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Border.treatmentCard:pointerover">
        <Setter Property="Background" Value="{StaticResource SpaItemHover}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontFamily" Value="Times New Roman, Georgia, serif"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource SpaTextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource SpaTextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.pageHeader">
        <Setter Property="FontFamily" Value="Georgia, serif"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBox.formElement">
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#950E1C13" />
        <Setter Property="BorderBrush" Value="#45FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style Selector="Button.adminCardButton">
        <Setter Property="Background" Value="#1A2B20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="140"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        Classes="glassCard"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Content}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.adminCardButton:pointerover /template/ Border">
        <Setter Property="Background" Value="#402D5A43"/>
        <Setter Property="BorderBrush" Value="{StaticResource SpaAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    
</Styles>