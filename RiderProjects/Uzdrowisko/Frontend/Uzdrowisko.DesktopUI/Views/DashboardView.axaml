<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Uzdrowisko.DesktopUI.ViewModels"
             xmlns:models="using:Uzdrowisko.DesktopUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Uzdrowisko.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="15">

        <TextBlock Text="Strona Główna"
                   Classes="pageHeader" />

        <Grid RowDefinitions="Auto,*">
            <!-- 1. OSOBNA KARTA DLA POGODY (Wiersz 0) -->
            <Border Grid.Row="0"
                    Classes="glassCard"
                    Padding="20">
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">

                    <!-- Miejscowość i status pogody -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="POGODA DLA SOLCA-ZDROJU"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SpaTextMuted}"
                                   LetterSpacing="1" />
                        <TextBlock Text="{Binding WeatherDescription}"
                                   FontSize="14"
                                   Foreground="#E8F1EC"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Pionowa linia rozdzielająca -->
                    <Rectangle Width="1" Fill="#25FFFFFF" Margin="5,0" />

                    <!-- Wartość temperatury -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Temperature}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="°C"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SpaTextMuted}"
                                   Margin="2,2,0,0"
                                   VerticalAlignment="Top" />
                    </StackPanel>

                </StackPanel>
            </Border>


            <Border
                Grid.Row="1"
                Classes="glassCard"
                Padding="24"
                Margin="0,30">
                <Grid RowDefinitions="Auto,*,*">
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="ZAPLANOWANE ZABIEGI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SpaTextMuted}"
                                   LetterSpacing="1" />
                        <TextBlock Text="{Binding Today, StringFormat='{}{0:dddd, d MMMM yyyy}'}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="400" Margin="0,80,0,0">
                        <StackPanel>
                            <TextBlock Text="Brak zaplanowanych zabiegów w dniu dzisiejszym."
                                       IsVisible="{Binding IsEmpty}"
                                       Foreground="{StaticResource SpaTextMuted}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,40,0,0" />

                            <ItemsControl ItemsSource="{Binding DayTreatments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AppointmentItem">
                                        <Border Classes="treatmentCard" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="110, *,Auto" ColumnSpacing="16">

                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding TimeRangeDisplay}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center" />
                                                    <Border Background="#25FFFFFF"
                                                            CornerRadius="8"
                                                            Padding="6,2"
                                                            Margin="0,4,0,0"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding DurationDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="#D0E3D7"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>


                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="{Binding TreatmentName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="15"
                                                               Foreground="#FFFFFF" />

                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="Pacjent:"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource SpaTextMuted}" />
                                                        <TextBlock Text="{Binding PatientFullName}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="#E8F1EC" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RoomDisplay}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SpaTextMuted}" />
                                                </StackPanel>


                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2"
                            Height="40"
                            Padding="16,8"
                            CornerRadius="12"
                            Background="#34523F"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            Margin="0,20,0,0"
                            Cursor="Hand"
                            Content="Zarządzaj zabiegami"
                            Command="{Binding NavigateToCalendarCommand}">
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>

</UserControl>