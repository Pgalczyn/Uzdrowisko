<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Uzdrowisko.DesktopUI.ViewModels"
             xmlns:models="clr-namespace:Uzdrowisko.DesktopUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Uzdrowisko.Views.PatientView"
             x:DataType="vm:PatientViewModel"
             x:Name="RootControl">

    <Grid>
        <Grid RowDefinitions="Auto, *" HorizontalAlignment="Left" Margin="30">
            
            <TextBlock Text="Lista Pacjentów" 
                       Classes="pageHeader"/>

            <Border Classes="glassCard"
                    Padding="24"
                    Grid.Row = "1"
                    Width = "900">
                <Grid RowDefinitions="Auto, *">
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,20" Orientation="Horizontal">
                        <Button
                            CornerRadius="12" 
                            Background="#34523F" 
                            Content="Wyjdź"
                            Foreground="White"
                            Command="{Binding GoBackCommand}"></Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="650">
                        <StackPanel>

                            <ItemsControl ItemsSource="{Binding PatientListItemDtos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PatientItem">
                                        <Button Command="{Binding #RootControl.((vm:PatientViewModel)DataContext).GoToTreatmentsCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,12"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </Button.Styles>
                                        <Border Classes="treatmentCard" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="*, Auto,Auto" ColumnSpacing="15">
                                                
                                                 <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{Binding Surname}" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#D0E3D7"/>
                                                    <TextBlock Text="{Binding Pesel, StringFormat='PESEL: {0}'}" FontSize="11" Foreground="{StaticResource SpaTextMuted}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="›"
                                                           FontSize="24"
                                                           Foreground="#50FFFFFF"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                            </Grid>
                                        </Border>
                                            </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

       
    </Grid>
</UserControl>