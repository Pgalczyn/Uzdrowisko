<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Uzdrowisko.DesktopUI.ViewModels"
             xmlns:models="clr-namespace:Uzdrowisko.DesktopUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Uzdrowisko.Views.UserView"
             x:DataType="vm:UserViewModel"
             x:Name="RootControl">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="15" Margin="20">
            <TextBlock Text="Lista Pacjentów" 
                       Classes="pageHeader"/>
            <Grid ColumnDefinitions="*,Auto">
                <ItemsControl ItemsSource="{Binding PatientListItemDtos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PatientItem">
                            <Border Background="#2518261E" CornerRadius="8" Padding="15" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                                    <!-- Dane pacjenta -->
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding Surname}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#D0E3D7"/>
                                        <TextBlock Text="{Binding Pesel, StringFormat='PESEL: {0}'}" FontSize="11" Foreground="#99D0DDD5"/>
                                    </StackPanel>

                                    <!-- Przycisk otwierający dialog usuwania dla konkretnego wiersza -->
                                    <Button Grid.Column="1"
                                            Content="Usuń"
                                            Command="{Binding #RootControl.((vm:UserViewModel)DataContext).OpenRemoveDialogCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#223B2A"
                                            Foreground="White"
                                            CornerRadius="6"
                                            Padding="12,6"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            
        </StackPanel>
            </Grid>
    </ScrollViewer>
            <Grid IsVisible="{Binding IsDialogVisible}">
    <Border Background="#34523F" 
            CornerRadius="15"
            Padding="25"
            Width="500"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <StackPanel Spacing="15" HorizontalAlignment="Stretch">
            <TextBlock Text="Usunąć pacjenta?"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            
            <TextBlock Text="{Binding SelectedPatient.Name, StringFormat='Imię: {0}'}" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding SelectedPatient.Surname, StringFormat='Nazwisko: {0}'}" Foreground="White" HorizontalAlignment="Center"/>
            <Button Content="Usuń pacjenta"
                    Command="{Binding RemovePatientCommand}"
                    Height="46" 
                    CornerRadius="12" 
                    Background="#223B2A"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"
                    FontSize="15" 
                    Margin="0,8,0,0" 
                    Cursor="Hand"/>

            <Button Content="Zamknij okno"
                    Command="{Binding CloseRemoveDialogCommand}"
                    Height="46" 
                    CornerRadius="12" 
                    Background="#223B2A"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"
                    FontSize="15" 
                    Margin="0,8,0,0" 
                    Cursor="Hand"/>
        </StackPanel>
    </Border>
</Grid>
            </Grid>
    
</UserControl>