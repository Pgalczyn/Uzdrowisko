<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Uzdrowisko.DesktopUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Uzdrowisko.Views.UpdateUserView"
             x:DataType="vm:UpdateUserViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowSpacing="15" RowDefinitions="Auto, *" Margin="30" HorizontalAlignment="Stretch">
        <Button
            CornerRadius="12" 
            Background="#34523F" 
            HorizontalContentAlignment="Left"
            Foreground="White"
            Content="Wyjdź"
            Command="{Binding GoBackCommand}"></Button>
        <TextBlock Text="Wprowadź dane Pacjenta" 
                   Classes="pageHeader"
                   HorizontalAlignment="Center"
                   Grid.Row="0"
                   Margin="0,0,0,10"/>
        <Grid Grid.Row="1" 
                     VerticalAlignment="Top" 
                     HorizontalAlignment="Stretch"
                     MaxWidth="600"
                     ColumnDefinitions="*,400"
                     >
            <StackPanel Grid.Column="0">
                    
            <StackPanel.Resources>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#99D0DDD5" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#CCD0DDD5" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#CCD0DDD5" />
                        <SolidColorBrush x:Key="TextControlBackground" Color="#4018261E" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#5518261E" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#5018261E" />

                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
                    </StackPanel.Resources>
                    

                    

                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#FF7A7A" 
                               FontSize="12"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBox Classes="formElement"
                             Watermark="Imię" 
                             Text="{Binding Name}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Nazwisko" 
                             Text="{Binding Surname}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Adres email" 
                             Text="{Binding Email}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Numer PESEL" 
                             Text="{Binding Pesel}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Data urodzenia" 
                             Text="{Binding DateOfBirth}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Numer telefonu" 
                             Text="{Binding PhoneNumber}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Adres" 
                             Text="{Binding Address}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Miasto" 
                             Text="{Binding City}"
                             VerticalContentAlignment="Center" />

                    <TextBox Classes="formElement"
                             Watermark="Kod pocztowy" 
                             Text="{Binding PostalCode}"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text="Dane zostały zapisane"
                               IsVisible="{Binding IsDialogVisible}"
                               Foreground="Red"
                               HorizontalAlignment="Center"></TextBlock>
                    <Button Content="Uaktualnij dane Pacjenta" 
                            Command="{Binding UpdateActionCommand}" 
                            Height="46" 
                            CornerRadius="12" 
                            Background="#34523F" 
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            FontSize="15" 
                            Margin="0,8,0,0" 
                            Cursor="Hand"/>

                    </StackPanel>
            <Border Grid.Column="1"
                        Classes="glassCard"
                        Padding="24"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Pobyt Pacjenta"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Data rozpoczęcia"
                                       FontSize="12"
                                       Foreground="#D0E3D7" />
                            <CalendarDatePicker SelectedDate="{Binding StayDateFrom, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch"
                                                Watermark="Wybierz datę od" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Data zakończenia"
                                       FontSize="12"
                                       Foreground="#D0E3D7" />
                            <CalendarDatePicker SelectedDate="{Binding StayDateTo, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch"
                                                Watermark="Wybierz datę do" />
                        </StackPanel>

                        
                        <Button Content="Dodaj pobyt"
                                Command="{Binding AddStayCommand}"
                                Height="44"
                                CornerRadius="12"
                                Background="#34523F"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                Margin="0,6,0,0"
                                Cursor="Hand" />
                    </StackPanel>
                </Border>
                </Grid>
        
        </Grid>
        </ScrollViewer>
</UserControl>
