<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Uzdrowisko.DesktopUI.ViewModels"
             xmlns:models="clr-namespace:Uzdrowisko.DesktopUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Uzdrowisko.Views.EmployeeView"
             x:DataType="vm:EmployeeViewModel"
             x:Name="RootControl">

    <Grid>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="15" Margin="30">
            
            <TextBlock Text="Lista Pracowników" 
                       Classes="pageHeader"/>

            <Border Classes="glassCard"
                    Padding="24"
                    Width="650">
                <Grid RowDefinitions="Auto, *">
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,20" Orientation="Horizontal">
                        <Button
                            CornerRadius="12" 
                            Background="#34523F" 
                            Content="Wyjdź"
                            Foreground="White"
                            Command="{Binding GoBackCommand}"></Button>
                        <Button
                            CornerRadius="12" 
                            Background="#34523F" 
                            Content="Zarejestruj użytkownika"
                            Foreground="White"
                            Command="{Binding GoToRegisterCommand}"></Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="650">
                        <StackPanel>

                            <ItemsControl ItemsSource="{Binding EmployeeListItemDtos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EmployeeItem">
                                        <Border Classes="treatmentCard" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15">
                                                
                                                 <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{Binding Surname}" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#D0E3D7"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Edytuj"
                                                        Command="{Binding #RootControl.((vm:EmployeeViewModel)DataContext).GoToEditCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#34523F"
                                                        Foreground="White"
                                                        CornerRadius="8"
                                                        Padding="14,8"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"/>
                                               <Button Grid.Column="2"
                                                        Content="Usuń"
                                                        Command="{Binding #RootControl.((vm:EmployeeViewModel)DataContext).OpenRemoveDialogCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#34523F"
                                                        Foreground="White"
                                                        CornerRadius="8"
                                                        Padding="14,8"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

       <Border Background="#18261E"
                IsVisible="{Binding IsDialogVisible}"
                HorizontalAlignment="Stretch"
                CornerRadius="16"
                VerticalAlignment="Stretch">
            <Border Background="#34523F" 
                    CornerRadius="15"
                    Padding="25"
                    Width="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="15" HorizontalAlignment="Stretch">
                    <TextBlock Text="Usunąć pracownika?"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding SelectedEmployee.Name, StringFormat='Imię: {0}'}" Foreground="#D0E3D7" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedEmployee.Surname, StringFormat='Nazwisko: {0}'}" Foreground="#D0E3D7" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Usuń pracownika"
                            Command="{Binding RemoveEmployeeCommand}"
                            Height="40" 
                            CornerRadius="8" 
                            Background="#223B2A"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            FontSize="14" 
                            Margin="0,8,0,0" 
                            Cursor="Hand"/>

                    <Button Content="Anuluj"
                            Command="{Binding CloseRemoveDialogCommand}"
                            Height="40" 
                            CornerRadius="8" 
                            Background="Transparent"
                            Foreground="#D0E3D7"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            FontSize="14" 
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>