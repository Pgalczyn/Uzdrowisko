<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Uzdrowisko.DesktopUI.ViewModels"
             xmlns:models="using:Uzdrowisko.DesktopUI.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Uzdrowisko.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">

    <Grid RowSpacing="20" RowDefinitions="Auto,*" ColumnDefinitions="*, 340" Margin="24" ColumnSpacing="24">
        
        <TextBlock Text="Terminarz" 
                   FontFamily="Times New Roman, Georgia, serif"
                   FontWeight="Light"
                   FontSize="32" 
                   Foreground="#FFFFFF"
                   Grid.ColumnSpan="2"
                   Margin="0,30"/>

        <Border Grid.Row="1" Grid.Column="0" 
                Classes="glassCard"
                Padding="24">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="ZAPLANOWANE ZABIEGI"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SpaTextMuted}"
                               LetterSpacing="1"/>
                    <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:dddd, d MMMM yyyy}'}"
                               FontSize="22" 
                               FontWeight="SemiBold" 
                               Foreground="#FFFFFF"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <TextBlock Text="Brak zaplanowanych zabiegów w wybranym dniu."
                                   IsVisible="{Binding IsEmpty}"
                                   Foreground="{StaticResource SpaTextMuted}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,0"/>

                        <ItemsControl ItemsSource="{Binding DayTreatments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AppointmentItem">
                                    <Border Classes="treatmentCard" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="90, *, Auto" ColumnSpacing="16">
                                            
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TimeRangeDisplay}" 
                                                           FontWeight="Bold" 
                                                           FontSize="14" 
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"/>
                                                <Border Background="#25FFFFFF"
                                                        CornerRadius="8"
                                                        Padding="6,2"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding DurationDisplay}" 
                                                               FontSize="11" 
                                                               Foreground="#D0E3D7"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding TreatmentName}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="15" 
                                                           Foreground="#FFFFFF"/>
                                                
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Pacjent:" 
                                                               FontSize="12" 
                                                               Foreground="{StaticResource SpaTextMuted}"/>
                                                    <TextBlock Text="{Binding PatientFullName}" 
                                                               FontSize="12" 
                                                               FontWeight="Medium"
                                                               Foreground="#E8F1EC"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RoomDisplay}" 
                                                           FontSize="11" 
                                                           Foreground="{StaticResource SpaTextMuted}"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" 
                                                    Width="32" 
                                                    Height="32" 
                                                    CornerRadius="16" 
                                                    Background="#25FFFFFF"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="›" 
                                                           FontSize="20" 
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="1,-2,0,0"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"  
                Classes="glassCard"
                Padding="20" 
                VerticalAlignment="Top">

            <StackPanel Spacing="14">
                <TextBlock Text="Kalendarz aktywności"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Margin="4,0,0,0"/>

                <Calendar SelectionMode="SingleDate" 
                          SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          Foreground="#FFFFFF"
                          HorizontalAlignment="Center">
                    <Calendar.Styles>
                        <Style Selector="CalendarItem">
                            <Setter Property="Background" Value="MediumSeaGreen"/>
                        </Style>

                        <Style Selector="CalendarDayButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#34523F"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Margin" Value="2"/>
                        </Style>

                        <Style Selector="CalendarDayButton:inactive">
                            <Setter Property="Foreground" Value="#40FFFFFF"/>
                        </Style>

                        <Style Selector="CalendarDayButton:pointerover">
                            <Setter Property="Background" Value="#30FFFFFF"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>

                        <Style Selector="CalendarDayButton:selected">
                            <Setter Property="Background" Value="{StaticResource SpaAccent}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>

                        <Style Selector="CalendarDayButton:today">
                            <Setter Property="BorderBrush" Value="#81C784"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </Style>

                        <Style Selector="CalendarButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                        <Style Selector="CalendarButton:inactive">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#40FFFFFF"/>
                        </Style>
                        <Style Selector="CalendarButton:pointerover">
                            <Setter Property="Background" Value="#30FFFFFF"/>
                        </Style>
                        <Style Selector="CalendarButton:selected">
                            <Setter Property="Background" Value="{StaticResource SpaAccent}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>
                    </Calendar.Styles>
                </Calendar>
            </StackPanel>
        </Border> 
        
    </Grid>
</UserControl>