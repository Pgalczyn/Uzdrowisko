<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Uzdrowisko.DesktopUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Uzdrowisko.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">

    <DockPanel>
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="Terminarz" FontSize="28" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center"/>
        <Border Background="White" CornerRadius="12" Padding="15" BoxShadow="0 4 12 #15000000">
            <Calendar SelectionMode="SingleDate" SelectedDate="{Binding SelectedDate}"/>
        </Border>        
    </StackPanel>
    
    </DockPanel>
</UserControl>
